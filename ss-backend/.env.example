# Kopiuj do .env i uzupełnij lokalnymi wartościami.
# Uruchomienie: set -a; source .env; set +a; ./mvnw spring-boot:run

DB_URL=jdbc:postgresql://localhost:5432/tutoring_app_test
DB_USERNAME=your_local_database_user
DB_PASSWORD=your_local_database_password

# JWT_SECRET musi być kluczem Base64 o długości co najmniej 256 bitów.
# Wygeneruj: openssl rand -base64 32
JWT_SECRET=replace_with_a_new_base64_secret

# AES_SECRET musi mieć dokładnie 16, 24 albo 32 bajty UTF-8.
# Wygeneruj np.: openssl rand -hex 16
AES_SECRET=replace_with_16_byte_secret
